    "description": "Backend for SIMES - Student Internship Monitoring and Evaluation System",
    "main": "src/server.js",
    "type": "module",
    "scripts": {
        "dev": "node --watch src/server.js",
        "start": "node src/server.js",
        "migrate": "prisma migrate dev",
