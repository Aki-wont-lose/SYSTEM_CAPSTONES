// prisma/schema.prisma
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// User model - Base for all 4 roles
model User {
  id           String     @id @default(cuid())
  email        String     @unique
  password     String?
  role         Role       @default(STUDENT)
  isActive     Boolean    @default(true)
  firstName    String?
  lastName     String?
  contactNumber String?
  mustChangePassword Boolean @default(false)
  theme        Theme      @default(LIGHT)
  coordinatorCourse String? // BSHM / BSIT / BSTM - for COORDINATOR role
  supervisorCompanyId String? // Company ID for SUPERVISOR to limit to assigned students

  // Password reset
  resetToken   String?
  resetTokenExpiresAt DateTime?

  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  // Relations
  student      Student?
  supervisorCompany Company? @relation("SupervisorCompany", fields: [supervisorCompanyId], references: [id])
  sentMessages     Message[] @relation("SentMessages")
  receivedMessages Message[] @relation("ReceivedMessages")
  notifications Notification[]
  sentConnections     Connection[] @relation("OutgoingConnections")
  receivedConnections Connection[] @relation("IncomingConnections")
  linkedAccounts      LinkedAccount[]

  @@index([email])
  @@index([role])
}

// Connection model - friend request that must be accepted before chatting
model Connection {
  id          String           @id @default(cuid())
  requesterId String
  addresseeId String
  status      ConnectionStatus @default(PENDING)
  respondedAt DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  requester User @relation("OutgoingConnections", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee User @relation("IncomingConnections", fields: [addresseeId], references: [id], onDelete: Cascade)

  @@unique([requesterId, addresseeId])
  @@index([requesterId, status])
  @@index([addresseeId, status])
}

// LinkedAccount - external Microsoft/Google account attached to a SIMES user
model LinkedAccount {
  id         String               @id @default(cuid())
  userId     String
  provider   LinkedAccountProvider
  providerId String
  email      String
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerId])
  @@index([userId])
}

// AuditLog - immutable trail of account and academic actions
model AuditLog {
  id          String      @id @default(cuid())
  userId      String?
  userEmail   String?
  userRole    String?
  action      AuditAction
  entity      String
  entityId    String?
  description String      @db.Text
  metadata    Json?
  ipAddress   String?
  createdAt   DateTime    @default(now())

  @@index([createdAt])
  @@index([userId])
  @@index([action])
  @@index([entity])
}


// Student model - Extended student information
model Student {
  id                 String       @id @default(cuid())
  userId             String       @unique
  studentId          String       @unique
  firstName          String
  lastName           String
  course             String
  section            String
  email              String
  contactNumber      String
  profilePicture     String?
  ojt_status         OJTStatus    @default(NOT_STARTED)
  requiredHours      Int          @default(486)
  completedHours     Int          @default(0)

  // Company / supervisor assignment
  companyId          String?
  supervisorName     String?
  supervisorEmail    String?
  supervisorContact  String?

  // OJT schedule
  workingDays        String?      // e.g. "Mon-Fri"
  workingHours       String?      // e.g. "8:00 AM - 5:00 PM"

  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  // Relations
  user               User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  company             Company?     @relation(fields: [companyId], references: [id])
  attendance          Attendance[]
  submissions         Submission[]
  logEntries          LogEntry[]
  weeklyTasks         WeeklyTask[]

  @@index([studentId])
  @@index([userId])
  @@index([ojt_status])
  @@index([companyId])
}

// Attendance model - Daily Time Record (DTR)
model Attendance {
  id              String    @id @default(cuid())
  studentId       String
  date            DateTime
  timeIn          DateTime?
  timeOut         DateTime?
  timeInPhoto     String?   @db.Text  // base64 camera capture at time in
  timeOutPhoto    String?   @db.Text  // base64 camera capture at time out
  renderedHours   Float     @default(0)
  status          AttendanceStatus @default(PRESENT)
  notes           String?
  reviewStatus    DtrReviewStatus  @default(DRAFT) // DRAFT -> SUBMITTED -> APPROVED | REJECTED
  reviewRemarks   String?   @db.Text
  reviewedById    String?
  reviewedByName  String?
  submittedAt     DateTime?
  reviewedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  student         Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, date])
  @@index([studentId])
  @@index([date])
  @@index([status])
  @@index([reviewStatus])
  @@index([date, reviewStatus])
}

// Announcement model
model Announcement {
  id          String    @id @default(cuid())
  title       String
  content     String    @db.Text
  category    String    @default("General")
  priority    Priority  @default(NORMAL)
  isActive    Boolean   @default(true)
  image       String?   @db.Text // base64 photo for dashboard announcing
  images      String?   @db.Text // JSON array of 3 photos for sliding carousel
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  publishedAt DateTime?

  @@index([isActive])
  @@index([publishedAt])
  @@index([priority])
}

// Partner Company model
model Company {
  id              String    @id @default(cuid())
  name            String
  address         String?
  latitude        Float?
  longitude       Float?
  contactPerson   String?
  contactNumber   String?
  email           String?
  industryType    String?
  programs        String[]  @default([]) // BSHM / BSIT / BSTM - empty = open to all programs
  availableSlots  Int       @default(0)
  status          CompanyStatus @default(ACTIVE)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  students        Student[]
  supervisors     User[]    @relation("SupervisorCompany")

  @@index([status])
}

// Requirement model - documents students must submit
// Coordinator/Admin uploads a PDF template (stored as base64) so students download -> edit name -> re-upload
model Requirement {
  id              String    @id @default(cuid())
  title           String
  description     String?   @db.Text
  isRequired      Boolean   @default(true)
  program         String?   // BSHM / BSIT / BSTM / null = all programs
  category        String?   // e.g. "Weekly Report", "Narrative", "Internship Plan"
  cadence         String?   @default("ONCE") // ONCE | WEEKLY — WEEKLY rolls into the next to-do on submit
  dueInDays       Int?      // days after posting before it counts as missing
  dueDate         DateTime? // absolute deadline; drives automated missing detection
  maxScore        Int       @default(0) // 0 = not graded
  autoGradeOnSubmit Boolean @default(false) // a submitted file earns maxScore automatically
  sortOrder       Int       @default(0)
  templateFile    String?   @db.Text // base64 PDF template (Coordinator/Admin) â€” student downloads
  templateFileName String?  // original filename e.g. Endorsement_Template.pdf
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  submissions     Submission[]
  weeklyTasks     WeeklyTask[]

  @@index([isRequired])
  @@index([program])
  @@index([dueDate])
}

// Weekly to-do generated when a student submits a WEEKLY requirement
model WeeklyTask {
  id            String    @id @default(cuid())
  studentId     String
  requirementId String?
  title         String
  description   String?   @db.Text
  weekOf        DateTime
  dueDate       DateTime
  status        String    @default("PENDING") // PENDING | COMPLETED | MISSING
  completedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  student       Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  requirement   Requirement? @relation(fields: [requirementId], references: [id], onDelete: Cascade)

  @@unique([studentId, requirementId, weekOf])
  @@index([studentId])
  @@index([weekOf])
  @@index([status])
}

// Submission model - a student's uploaded file for a Requirement
model Submission {
  id              String    @id @default(cuid())
  requirementId   String
  studentId       String
  fileName        String
  fileData        String    @db.Text  // base64 file content
  status          SubmissionStatus @default(PENDING)
  remarks         String?   @db.Text
  score           Int?      // points awarded (auto or manual)
  isAutoGraded    Boolean   @default(false)
  submittedAt     DateTime  @default(now())
  reviewedAt      DateTime?

  // Relations
  requirement     Requirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  student         Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([requirementId])
  @@index([studentId])
  @@index([status])
}

// LogEntry model - "My Logs" daily task journal (separate from DTR)
model LogEntry {
  id              String    @id @default(cuid())
  studentId       String
  date            DateTime
  taskDescription String    @db.Text
  assignedBy      String?   // admin/supervisor who assigned the task
  status          LogStatus @default(PENDING)
  comment         String?   @db.Text   // admin/supervisor feedback
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  student         Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([date])
  @@index([status])
}

// 4 user levels â€” adviser required: ADMIN, COORDINATOR, SUPERVISOR, STUDENT
enum Role {
  ADMIN
  COORDINATOR
  SUPERVISOR
  STUDENT
}

enum Theme {
  LIGHT
  DARK
}

enum OJTStatus {
  NOT_STARTED
  ONGOING
  COMPLETED
  ON_HOLD
  FAILED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum ConnectionStatus {
  PENDING
  ACCEPTED
  DECLINED
}

enum DtrReviewStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

enum Priority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum CompanyStatus {
  ACTIVE
  INACTIVE
}

enum SubmissionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum LogStatus {
  PENDING
  APPROVED
  REVISION_REQUESTED
}

// Microsoft/Google account linked to a local SIMES account for single sign-on
enum LinkedAccountProvider {
  MICROSOFT
  GOOGLE
}

// Audit trail - who changed what, kept even if the user record is deleted
enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGIN_FAILED
  LOGOUT
  REVIEW
  SUBMIT
  EXPORT
  LINK
  UNLINK
}


// Messaging â€” Coordinator â†” Supervisor (ADMIN can also message)
model Message {
  id         String   @id @default(cuid())
  senderId   String
  receiverId String
  content    String   @db.Text
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())

  sender   User @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)

  @@index([senderId])
  @@index([receiverId])
  @@index([createdAt])
  @@index([isRead])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  content   String   @db.Text
  image     String?  @db.Text
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
}

