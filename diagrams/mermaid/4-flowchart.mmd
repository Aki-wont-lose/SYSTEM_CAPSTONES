%%{init: {'theme':'base','themeVariables':{'fontFamily':'Segoe UI, Arial, sans-serif','fontSize':'15px','primaryColor':'#EAF1FF','primaryTextColor':'#132A5E','primaryBorderColor':'#1B4DB1','lineColor':'#334155'}}}%%
flowchart TD
    START([START]):::term
    B1["Open SIMES in<br/>a web browser"]:::step
    B2["Sign in with<br/>Microsoft (SSO)"]:::step
    D1{"Credentials<br/>valid?"}:::dec
    ERR["Show error message<br/>and retry"]:::err
    B3["Load user role from<br/>the database"]:::step
    D2{"Which role?"}:::dec

    subgraph STUDENT
        S1["STUDENT DASHBOARD"]:::dash
        S2["• Time In / Time Out (DTR)<br/>• Write daily logs<br/>• Submit requirements<br/>• View weekly tasks<br/>• Read announcements<br/>• Message supervisor<br/>• Update profile"]:::act
    end
    subgraph SUPERVISOR
        P1["SUPERVISOR DASHBOARD"]:::dash
        P2["• View assigned interns<br/>• Review / approve DTR<br/>• Grade submissions<br/>• Give log feedback<br/>• Monitor progress<br/>• Message coordinator"]:::act
    end
    subgraph COORDINATOR
        C1["COORDINATOR DASHBOARD"]:::dash
        C2["• Create students<br/>• Create requirements<br/>• Assign companies<br/>• Review submissions<br/>• Monitor DTR<br/>• Message supervisors<br/>• Export reports"]:::act
    end
    subgraph ADMIN
        A1["ADMIN DASHBOARD"]:::dash
        A2["• Manage all accounts<br/>• Manage companies<br/>• Post announcements<br/>• Oversee requirements<br/>• View audit logs<br/>• Generate reports"]:::act
    end

    D3{"More tasks<br/>to do?"}:::dec
    OUT["Log out / close<br/>the browser"]:::step
    END([END]):::term

    START --> B1 --> B2 --> D1
    D1 -->|YES| B3
    D1 -->|NO| ERR
    ERR --> B2
    B3 --> D2
    D2 -->|STUDENT| S1
    D2 -->|SUPERVISOR| P1
    D2 -->|COORDINATOR| C1
    D2 -->|ADMIN| A1
    S1 --> S2
    P1 --> P2
    C1 --> C2
    A1 --> A2
    S2 --> D3
    P2 --> D3
    C2 --> D3
    A2 --> D3
    D3 -->|YES| D2
    D3 -->|NO| OUT
    OUT --> END

    classDef term fill:#DCFCE7,stroke:#15803D,stroke-width:2px,color:#14532D;
    classDef step fill:#EFF6FF,stroke:#1B4DB1,stroke-width:2px,color:#132A5E;
    classDef dec fill:#FEF9C3,stroke:#A16207,stroke-width:2px,color:#713F12;
    classDef err fill:#FEF2F2,stroke:#B91C1C,stroke-width:2px,color:#7F1D1D;
    classDef dash fill:#E0E7FF,stroke:#1B4DB1,stroke-width:2px,color:#132A5E;
    classDef act fill:#F8FAFC,stroke:#94A3B8,stroke-width:1.5px,color:#334155;
