VITE_API_URL=http://localhost:5000/api

# Students sign in via Microsoft OR Google (Admin uses email/password instead
# and needs neither of these). At least one must be filled in for students
# to be able to log in at all.

# Microsoft Sign-In (pending STI IT department provisioning student accounts)
VITE_MS_CLIENT_ID=
VITE_MS_TENANT=common

# Google Sign-In (students already have STI-issued Google accounts — usable
# now as an interim option while Microsoft accounts are pending)
VITE_GOOGLE_CLIENT_ID=
